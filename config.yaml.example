# TokenLens Provider 配置模板
# 使用方法：复制本文件为 config.yaml，按需修改后重启 TokenLens
#
# 规则：
# 1. 每个 provider 的 key 名（如 openai、anthropic）就是路由名，
#    在 CC Switch 中把 Base URL 改为 http://127.0.0.1:7788/<key名>
# 2. base_url 不含 /v1 后缀（结尾有 /v1 会启动报错）
# 3. type 只能是 openai 或 anthropic
# 4. api_key 可省略：
#    - 客户端（Codex 等）或 CC Switch 已带 Authorization / x-api-key 时，原样透传，无需填写
#    - 只有请求完全没有鉴权头时，TokenLens 才用这里的 api_key 兜底补充
# 5. 修改配置后需重启 TokenLens 生效

providers:

  openai:
    type: openai
    base_url: https://api.openai.com
    # api_key: sk-xxx

  anthropic:
    type: anthropic
    base_url: https://api.anthropic.com
    # api_key: sk-ant-xxx
